# Copy this to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored - never commit real OCIDs/keys.

tenancy_ocid = "<redacted>"
user_ocid    = "<redacted>"
fingerprint  = "<redacted>"

private_key_path = "<redacted>"

region           = "me-jeddah-1"
compartment_ocid = "<redacted>"

