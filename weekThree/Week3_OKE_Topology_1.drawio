        <mxCell id="139747593981008" value="Finishing this diagram with the official OCI icon set" style="whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;dashed=0;fontStyle=1;fontSize=20;fontColor=#17324D;align=left;verticalAlign=top;" vertex="1" parent="1">
  <mxGeometry x="20" y="20" width="900" height="40" as="geometry" />
</mxCell>
        <mxCell id="139747593982160" value="This page&apos;s boxes are plain placeholder shapes (not the licensed OCI icon set), because this environment could not download Oracle&apos;s proprietary draw.io library over the network. To swap in the real icons on your own machine:&#xa;&#xa;1. Download the official library: docs.oracle.com/iaas/Content/Resources/Assets/OCI-Style-Guide-for-Drawio.zip&#xa;2. In draw.io: click &quot;More Shapes&quot; at the bottom of the left shape panel (or File &gt; Open Library...), then browse to the .xml file inside the extracted zip. This adds an &quot;Oracle Cloud Infrastructure&quot; category to your shape panel.&#xa;3. On the Topology page, drag the matching OCI icon (see the table below) on top of each placeholder box, delete the placeholder, then reconnect the 1-2 arrows that touched it -- the layout, spacing, and orthogonal routing are already correct, so this is quick." style="whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;dashed=0;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=top;" vertex="1" parent="1">
  <mxGeometry x="20" y="70" width="1040" height="220" as="geometry" />
</mxCell>
