#!/bin/bash
# Cloud-init script for the private instance. Templated by Terraform
# (templatefile() in main.tf) so the NFS mount target IP and export path
# never get hardcoded — they're only known after Terraform creates those
# resources, which is exactly what templatefile() is for.
set -eux

# Oracle Linux ships with firewalld active by default, which blocks inbound
# connections on any port that isn't explicitly opened — independent of
# (and in addition to) the VCN security list. Without this, the load
# balancer's health check gets "connection failed" even though the
# security list already permits the traffic.
if systemctl is-active --quiet firewalld; then
  firewall-cmd --permanent --add-port=${app_port}/tcp
  firewall-cmd --reload
fi

MOUNT_POINT="/mnt/appdata"
mkdir -p "$MOUNT_POINT"

# The mount target can take a few seconds to be fully reachable right after
# creation, so retry instead of failing the whole boot on the first try.
for i in $(seq 1 10); do
  if mount -t nfs "${mount_target_ip}:${export_path}" "$MOUNT_POINT"; then
    break
  fi
  sleep 10
done

grep -q "$MOUNT_POINT" /etc/fstab || \
  echo "${mount_target_ip}:${export_path} $MOUNT_POINT nfs defaults,_netdev 0 0" >> /etc/fstab

# Lab 2 requirement: the application's files live on File Storage, not
# baked into the instance image. Seed a minimal page there if it's not
# already present (so re-running this on a replaced instance doesn't wipe
# out anything real that got put there later).
if [ ! -f "$MOUNT_POINT/index.html" ]; then
  cat > "$MOUNT_POINT/index.html" <<'HTML'
<!DOCTYPE html>
<html>
  <head><title>tf-lab-app-AliYousef</title></head>
  <body>
    <h1>Ejada Internship - Week 2 Lab</h1>
    <p>Served from the private compute instance, behind the load balancer.</p>
    <p>These files live on OCI File Storage, mounted over NFS to /mnt/appdata.</p>
  </body>
</html>
HTML
fi

# Run the app as a systemd service so it survives reboots, rather than a
# background process that dies with the SSH session that started it.
cat > /etc/systemd/system/tflabapp.service <<UNIT
[Unit]
Description=tf-lab week 2 application
After=network.target remote-fs.target

[Service]
WorkingDirectory=$MOUNT_POINT
ExecStart=/usr/bin/python3 -m http.server ${app_port}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now tflabapp.service
