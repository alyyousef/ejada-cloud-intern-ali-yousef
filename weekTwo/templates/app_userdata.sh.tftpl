#!/bin/bash
set -eux

if systemctl is-active --quiet firewalld; then
  firewall-cmd --permanent --add-port=${app_port}/tcp
  firewall-cmd --reload
fi

MOUNT_POINT="/mnt/appdata"
mkdir -p "$MOUNT_POINT"

for i in $(seq 1 10); do
  if mount -t nfs "${mount_target_ip}:${export_path}" "$MOUNT_POINT"; then
    break
  fi
  sleep 10
done

grep -q "$MOUNT_POINT" /etc/fstab || \
  echo "${mount_target_ip}:${export_path} $MOUNT_POINT nfs defaults,_netdev 0 0" >> /etc/fstab

if [ ! -f "$MOUNT_POINT/index.html" ]; then
  cat > "$MOUNT_POINT/index.html" <<'HTML'
<!DOCTYPE html>
<html>
  <head><title>tf-lab-app-AliYousef</title></head>
  <body>
    <h1>Ejada Internship - Week 2 Lab</h1>
    <p>Served from the private compute instance, behind the load balancer.</p>
    <p>These files live on OCI File Storage, mounted over NFS to /mnt/appdata.</p>
  </body>
</html>
HTML
fi

cat > /etc/systemd/system/tflabapp.service <<UNIT
[Unit]
Description=tf-lab week 2 application
After=network.target remote-fs.target

[Service]
WorkingDirectory=$MOUNT_POINT
ExecStart=/usr/bin/python3 -m http.server ${app_port}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now tflabapp.service
